{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue"
  ],
  "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "baseUrl": "./",
        "strict": true,
        "paths": {
            "@/*": ["src/*"],
            "@components/*": ["src/components/*"],
            "@pages/*": ["src/pages/*"],
            "@config/*": ["src/config/*"],
            "@layouts/*": ["src/layouts/*"],
            "@service/*": ["src/services/*"],
            "@stores/*": ["src/stores/*"],
            "@utils/*": ["src/utils/*"],
            "@types/*": ["src/types/*"]
        }
  },
  "exclude": [
    "src/**/__tests__/*"
  ]
}